# Скопируйте этот файл в ftp-upload.env и подставьте свои данные (ftp-upload.env в git не попадает).

FTP_HOST=ftp.ваш-сайт.ru
FTP_USER=логин_от_ftp
FTP_PASSWORD=пароль_от_ftp

# Папка на сервере, куда заливать (как в файловом менеджере хостинга), без начального слэша или со слэшем — как принято у провайдера.
# Примеры: public_html/launcher  |  www/launcher  |  domains/site.ru/public_html/launcher
FTP_REMOTE_DIR=public_html/launcher

# Публичный HTTPS-адрес этой же папки (как откроется в браузере после заливки).
HTTPS_PUBLIC_BASE=https://afterlifedayz.ru/launcher

# Порт (если не 21)
# FTP_PORT=21

# Если хост требует шифрованный FTP (FTPS), раскомментируйте:
# FTP_SECURE=1

# Если FiveM.zip не в bundled-fivem/FiveM.zip:
# FIVEM_ZIP_PATH=C:\полный\путь\FiveM.zip

# Подробный лог FTP в консоль:
# FTP_DEBUG=1
